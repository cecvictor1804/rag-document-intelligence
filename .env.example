# ─────────────────────────────────────────────────────────────────────────────
# Internal Documentation RAG — environment variables
# Copy to `.env` for local dev. NEVER commit `.env`. In AWS these come from
# Secrets Manager / App Runner config, not from a file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Postgres + pgvector) ──────────────────────────────────────────
# Local dev value matches docker-compose.yml. In prod this is the RDS endpoint.
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# ── Document source ─────────────────────────────────────────────────────────
# "local" reads from a folder (dev); "s3" reads from a bucket (prod).
DOC_SOURCE=local
# For DOC_SOURCE=local:
LOCAL_DOCS_PATH=./sample_docs
# For DOC_SOURCE=s3:
S3_BUCKET=
S3_PREFIX=
AWS_REGION=us-east-1

# ── Embeddings ──────────────────────────────────────────────────────────────
# Provider: "voyage" (default) or "openai".
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024
VOYAGE_API_KEY=
# Only if EMBEDDING_PROVIDER=openai:
OPENAI_API_KEY=

# ── Reranker ────────────────────────────────────────────────────────────────
RERANK_PROVIDER=voyage
RERANK_MODEL=rerank-2

# ── Chunking (tunable) ──────────────────────────────────────────────────────
CHUNK_TOKENS=600
CHUNK_OVERLAP_RATIO=0.15

# ── Retrieval (tunable) ─────────────────────────────────────────────────────
DENSE_TOP_K=50
LEXICAL_TOP_K=50
RRF_K=60
FUSE_TOP_K=40
RERANK_TOP_K=8
# Below this rerank score we take the "I don't know" path.
MIN_RERANK_SCORE=0.3

# ── Generation (Claude) + model routing ─────────────────────────────────────
ANTHROPIC_API_KEY=
# Routing thresholds (see backend/app/llm/router.py). All tunable.
ROUTER_ENABLED=true
ROUTER_MODEL_CHEAP=claude-haiku-4-5
ROUTER_MODEL_MID=claude-sonnet-4-6
ROUTER_MODEL_STRONG=claude-opus-4-8
# Retrieval confidence (top rerank score) at/above which a query is "easy".
ROUTER_HIGH_CONFIDENCE=0.65
# Below this confidence we escalate to the strong model.
ROUTER_LOW_CONFIDENCE=0.45
# Context token count above which we escalate to the strong (1M ctx) model.
ROUTER_LONG_CONTEXT_TOKENS=150000
ROUTER_DEFAULT_EFFORT=medium

# ── Auth (Google Workspace SSO / OIDC) ──────────────────────────────────────
# When false (default) the API is open and callers are anonymous — keeps local
# dev/tests runnable without a Google client. Set true to enforce the SSO gate
# (the Next.js frontend forwards a Google ID token the backend verifies here).
AUTH_ENABLED=false
# Restrict logins to this Google Workspace hosted domain (the `hd` claim).
GOOGLE_HOSTED_DOMAIN=example.com
GOOGLE_OAUTH_CLIENT_ID=
# Audience the backend requires on incoming Google ID tokens. Defaults to
# GOOGLE_OAUTH_CLIENT_ID when left blank.
OIDC_AUDIENCE=

# ── Financial extraction (Phase 5) ──────────────────────────────────────────
# "html"     = built-in parser for native-HTML filings (EDGAR 10-K/10-Q); free.
# "textract" = AWS Textract for PDFs/scans — needs AWS credentials, costs per
#              page, keeps documents in your AWS account (no third-party vendor).
FINANCIAL_PARSER=html
# NL→query planner: lets the chat answer with verified figures from the metric
# store (one extra cheap Claude call per question). false = narrative RAG only.
PLANNER_ENABLED=true
# Required for `make edgar-sync` (SEC fair-access policy): a descriptive
# User-Agent with contact info. Empty disables the EDGAR feed.
EDGAR_USER_AGENT=

# ── Ingestion worker (S3 -> SQS, prod) ──────────────────────────────────────
INGEST_SQS_QUEUE_URL=

# ── App ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENV=development
